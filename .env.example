# Copy this file to .env and fill it in.

# Your Claude API key from https://platform.claude.com (without it Gino runs on a simple practice brain)
ANTHROPIC_API_KEY=

# Your name, and your time zone so Gino knows when it's night for you
GINO_DAD_NAME=Raul
GINO_TZ=Europe/London
# north or south: which half of the world you live in, so his seasons match yours
GINO_HEMISPHERE=north

# Most Gino may spend on thinking per day, in US dollars. When it's used up he just chills until morning.
GINO_DAILY_BUDGET_USD=3

# Which Claude model is Gino's brain. claude-opus-5-5 (smartest), claude-sonnet-5-5 (about half the price),
# claude-haiku-5-5 (very cheap, simpler). GINO_CHAT_MODEL lets chats use a different one.
GINO_MODEL=claude-opus-5-5
# GINO_CHAT_MODEL=claude-opus-5-5
# How hard he thinks each turn: low, medium, high
GINO_EFFORT=medium

# Let Gino browse the web (1 = yes, 0 = no)
GINO_WEB=1

# Shortest / longest gap between Gino's turns, in minutes
GINO_MIN_WAKE_MINUTES=15
GINO_MAX_WAKE_MINUTES=360

# Only needed when Gino lives on a server on the internet
# GINO_HOST=0.0.0.0
# GINO_PASSWORD=pick-something-long

# Gino's Bluesky account (optional). Use an APP PASSWORD from Bluesky (Settings > Privacy and security >
# App passwords), never the real account password. GINO_SOCIAL=1 switches posting on.
# GINO_SOCIAL=0
# GINO_BLUESKY_HANDLE=gino-capybara.bsky.social
# GINO_BLUESKY_APP_PASSWORD=
# GINO_SOCIAL_MAX_PER_DAY=3
# GINO_SOCIAL_MIN_GAP_MINUTES=120
# Your Gino's web address, so his posts can link to his diary (the server sets this for you)
# GINO_PUBLIC_URL=https://203-0-113-7.sslip.io
