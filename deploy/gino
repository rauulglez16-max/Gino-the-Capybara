#!/usr/bin/env bash
# Little helper for looking after Gino on his server. Type `gino` to see what it can do.
set -euo pipefail

as_gino() { HOME=/opt/gino setpriv --reuid=gino --regid=gino --init-groups -- "$@"; }

ENV_FILE=/etc/gino/gino.env
APP=/opt/gino/app

need_root() { [ "$(id -u)" -eq 0 ] || { echo "Please run this as root (or with sudo)."; exit 1; }; }
setting() { grep -m1 "^$1=" "$ENV_FILE" | cut -d= -f2-; }
set_setting() {  # set_setting NAME value
  local tmp; tmp="$(mktemp)"
  grep -v "^$1=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$1" "$2" >> "$tmp"
  cat "$tmp" > "$ENV_FILE"; rm -f "$tmp"
}
unset_setting() {  # unset_setting NAME
  local tmp; tmp="$(mktemp)"
  grep -v "^$1=" "$ENV_FILE" > "$tmp" || true
  cat "$tmp" > "$ENV_FILE"; rm -f "$tmp"
}

case "${1:-help}" in
  status)
    systemctl is-active --quiet gino && echo "🌿 Gino is running." || echo "😴 Gino is NOT running (try: gino restart, then gino logs)."
    echo "   Address:  https://$(cat /var/lib/gino-deploy/domain 2>/dev/null)   (private, needs the password)"
    echo "   Public website: https://$(cat /var/lib/gino-deploy/domain 2>/dev/null)/blog   (anyone can read it)"
    echo "   Version:  $(as_gino git -C "$APP" log -1 --format='%h %s (%cr)')"
    echo "   Brain:    $( [ -n "$(setting ANTHROPIC_API_KEY)" ] && setting GINO_MODEL || echo 'practice brain (no key yet: gino set-key)')"
    echo "   Next update check: $(systemctl list-timers gino-update.timer --no-legend | awk '{print $1, $2, $3}')"
    echo "   Phone:    $( [ -n "$(setting TELEGRAM_CHAT_ID)" ] && echo 'connected to Telegram 📱' || echo 'not connected (gino telegram)')"
    if [ -s /var/lib/gino-deploy/bad-commit ]; then
      echo "   ⚠️  Skipped version $(head -c 7 /var/lib/gino-deploy/bad-commit) because it wouldn't start."
    fi
    ;;
  logs)    journalctl -u gino -u gino-update -n "${2:-80}" --no-pager ;;
  follow)  journalctl -u gino -f ;;
  restart) need_root; systemctl restart gino; echo "Gino restarted." ;;
  stop)    need_root; systemctl stop gino; echo "Gino is paused. Start him again with: gino start" ;;
  start)   need_root; systemctl start gino; echo "Gino is up." ;;
  update)  need_root; bash "$APP/deploy/update.sh" --verbose ;;
  backup)  need_root; bash "$APP/deploy/update.sh" --backup-only ;;
  password)
    need_root
    if [ -n "${2:-}" ]; then set_setting GINO_PASSWORD "$2"; systemctl restart gino; echo "Password changed."
    else echo "Gino's password: $(setting GINO_PASSWORD)"; fi
    ;;
  set-key)
    need_root
    read -r -p "Paste your Claude API key: " key
    [ -n "$key" ] || { echo "Nothing pasted, nothing changed."; exit 1; }
    set_setting ANTHROPIC_API_KEY "$key"; systemctl restart gino
    echo "Gino has his real brain now. 🧠"
    ;;
  telegram)
    need_root
    case "${2:-}" in
      off)
        unset_setting TELEGRAM_BOT_TOKEN; unset_setting TELEGRAM_CHAT_ID; systemctl restart gino
        echo "Gino's phone line is off. Connect again any time with: gino telegram" ;;
      test)
        [ -n "$(setting TELEGRAM_CHAT_ID)" ] || { echo "Not connected yet. Run: gino telegram"; exit 1; }
        TELEGRAM_BOT_TOKEN="$(setting TELEGRAM_BOT_TOKEN)" CHAT="$(setting TELEGRAM_CHAT_ID)" python3 -I -c '
import json, os, urllib.request
t, c = os.environ["TELEGRAM_BOT_TOKEN"], os.environ["CHAT"]
r = urllib.request.Request(f"https://api.telegram.org/bot{t}/sendMessage", headers={"Content-Type": "application/json"},
    data=json.dumps({"chat_id": c, "text": "🔔 Test from the server: the phone line works!"}).encode())
urllib.request.urlopen(r, timeout=15)' && echo "Sent a test message. Check your phone. 📱" \
          || echo "That didn't work. Try connecting again with: gino telegram" ;;
      *)
        echo "Let's connect Gino to your phone. 📱"
        echo "(If you haven't made a bot yet: in Telegram, message @BotFather, send /newbot, and follow along.)"
        read -r -p "Paste the token BotFather gave you: " token
        token="$(printf '%s' "$token" | tr -d '[:space:]')"
        [ -n "$token" ] || { echo "Nothing pasted, nothing changed."; exit 1; }
        systemctl stop gino  # so only this setup is listening to the bot for a moment
        if chat="$(TELEGRAM_BOT_TOKEN="$token" python3 -I "$APP/deploy/telegram_pair.py")" && [ -n "$chat" ]; then
          set_setting TELEGRAM_BOT_TOKEN "$token"; set_setting TELEGRAM_CHAT_ID "$chat"
          systemctl start gino
          echo; echo "🎉 Done! Gino can text you now, and you can text him back. Nobody else can talk to him there."
        else
          systemctl start gino
          echo "Nothing changed. Gino is back to normal."; exit 1
        fi ;;
    esac
    ;;
  settings) need_root; "${EDITOR:-nano}" "$ENV_FILE" && systemctl restart gino && echo "Saved and restarted." ;;
  *)
    cat <<'EOF'
gino status      is he running, which version, which brain
gino logs        what happened recently
gino follow      watch what he's doing live (Ctrl+C to stop watching)
gino restart     restart him
gino stop/start  pause him / wake him up again
gino update      check GitHub for new code right now
gino backup      save a copy of his memories now
gino password    show (or: gino password NEW to change) the page password
gino set-key     give him his Claude API key
gino telegram    connect him to your phone (gino telegram test / gino telegram off)
gino settings    edit all his settings
EOF
    ;;
esac
