#!/usr/bin/env bash
# Little helper for looking after Gino on his server. Type `gino` to see what it can do.
set -euo pipefail

as_gino() { HOME=/opt/gino setpriv --reuid=gino --regid=gino --init-groups -- "$@"; }

ENV_FILE=/etc/gino/gino.env
APP=/opt/gino/app

need_root() { [ "$(id -u)" -eq 0 ] || { echo "Please run this as root (or with sudo)."; exit 1; }; }
setting() { { grep -m1 "^$1=" "$ENV_FILE" || true; } | cut -d= -f2-; }
set_setting() {  # set_setting NAME value
  local tmp; tmp="$(mktemp)"
  grep -v "^$1=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$1" "$2" >> "$tmp"
  cat "$tmp" > "$ENV_FILE"; rm -f "$tmp"
}
unset_setting() {  # unset_setting NAME
  local tmp; tmp="$(mktemp)"
  grep -v "^$1=" "$ENV_FILE" > "$tmp" || true
  cat "$tmp" > "$ENV_FILE"; rm -f "$tmp"
}

server_ip() {
  local ip
  ip="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="src") print $(i+1)}' | head -1)"
  [ -n "$ip" ] || ip="$(curl -4 -fsS --max-time 5 https://api.ipify.org || true)"
  printf '%s' "$ip"
}
points_here() {  # points_here NAME IP: does NAME's address (A record) lead to this server?
  getent ahostsv4 "$1" 2>/dev/null | awk '{print $1}' | grep -qx "$2"
}
write_caddyfile() {  # write_caddyfile MAIN [OTHER-ADDRESSES...]: MAIN serves Gino, the others send visitors to MAIN
  local main="$1"; shift
  local tmp; tmp="$(mktemp)"
  {
    echo "# Gino's front door. Caddy gets and renews the https certificates by itself."
    echo "# Written by: gino domain"
    printf '%s {\n\tencode gzip\n\treverse_proxy 127.0.0.1:8787\n}\n' "$main"
    for other in "$@"; do
      printf '\n%s {\n\tredir https://%s{uri} 308\n}\n' "$other" "$main"
    done
  } > "$tmp"
  if ! caddy validate --config "$tmp" --adapter caddyfile >/dev/null 2>&1; then
    rm -f "$tmp"; echo "❌ Something went wrong writing the web server settings. Nothing changed."; exit 1
  fi
  cp /etc/caddy/Caddyfile /var/lib/gino-deploy/Caddyfile.before-domain 2>/dev/null || true
  cat "$tmp" > /etc/caddy/Caddyfile; rm -f "$tmp"
  systemctl reload caddy || systemctl restart caddy
}
install_narrator() {  # the offline voice that reads Gino's captions in polished videos (Piper, about 120 MB)
  local dir=/opt/gino/voices voice=/opt/gino/voices/en_US-lessac-medium.onnx tmp
  if /opt/gino/venv/bin/python -c "import piper" 2>/dev/null && [ -s "$voice" ] && [ -s "$voice.json" ]; then
    set_setting GINO_POLISH_VOICE "$voice"; return 0
  fi
  echo "Installing the narrator's voice (about 120 MB). This takes a minute or two..."
  /opt/gino/venv/bin/pip install -q piper-tts || return 1
  mkdir -p "$dir"; tmp="$(mktemp -d)"
  local hf=https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/lessac/medium/en_US-lessac-medium.onnx
  if curl -fsSL --retry 3 -o "$tmp/v.onnx" "$hf" && curl -fsSL --retry 3 -o "$tmp/v.onnx.json" "$hf.json"; then :
  elif curl -fsSL --retry 3 -o "$tmp/v.tgz" \
         https://github.com/rhasspy/piper/releases/download/v0.0.2/voice-en-us-lessac-medium.tar.gz \
       && tar -xzf "$tmp/v.tgz" -C "$tmp"; then
    mv "$tmp/en-us-lessac-medium.onnx" "$tmp/v.onnx"; mv "$tmp/en-us-lessac-medium.onnx.json" "$tmp/v.onnx.json"
  else
    rm -rf "$tmp"; return 1
  fi
  mv "$tmp/v.onnx" "$voice"; mv "$tmp/v.onnx.json" "$voice.json"; rm -rf "$tmp"
  chmod -R a+rX "$dir"
  set_setting GINO_POLISH_VOICE "$voice"
}
use_address() {  # use_address NAME: remember NAME as Gino's main address everywhere
  printf '%s\n' "$1" > /var/lib/gino-deploy/domain
  if [ -n "$(setting GINO_PUBLIC_URL)" ]; then set_setting GINO_PUBLIC_URL "https://$1"; fi
  systemctl restart gino
}

case "${1:-help}" in
  status)
    systemctl is-active --quiet gino && echo "🌿 Gino is running." || echo "😴 Gino is NOT running (try: gino restart, then gino logs)."
    echo "   Welcome page:  https://$(cat /var/lib/gino-deploy/domain 2>/dev/null)   (for everyone)"
    echo "   Your private page:  https://$(cat /var/lib/gino-deploy/domain 2>/dev/null)/private   (needs the password)"
    echo "   His diary: https://$(cat /var/lib/gino-deploy/domain 2>/dev/null)/blog   Live: https://$(cat /var/lib/gino-deploy/domain 2>/dev/null)/live"
    echo "   Version:  $(as_gino git -C "$APP" log -1 --format='%h %s (%cr)')"
    echo "   Brain:    $( [ -n "$(setting ANTHROPIC_API_KEY)" ] && setting GINO_MODEL || echo 'practice brain (no key yet: gino set-key)')"
    echo "   Next update check: $(systemctl list-timers gino-update.timer --no-legend | awk '{print $1, $2, $3}')"
    echo "   Telegram: $( [ -n "$(setting TELEGRAM_CHAT_ID)" ] && echo 'connected 📱' || echo 'not connected (gino telegram)')"
    echo "   WhatsApp: $( [ -n "$(setting WHATSAPP_TOKEN)" ] && echo "connected 📱 (nudge template: $(setting WHATSAPP_TEMPLATE))" || echo 'not connected (gino whatsapp)')"
    disk_pct="$(df --output=pcent /opt/gino | tail -1 | tr -dc 0-9)"
    echo "   Disk:     $(df -h --output=used,size /opt/gino | tail -1 | awk '{print $1 " of " $2}') used (${disk_pct}%)$( [ "${disk_pct:-0}" -ge 85 ] && echo '  ⚠️  nearly full!')"
    echo "   Memory:   $(free -h | awk '/^Mem:/{print $3 " of " $2 " in use"}')$(free -h | awk '/^Swap:/{ if ($2 != "0B") print ", spare (swap) " $2}')"
    [ -f /opt/gino/data/filming ] && echo "   🎬 Filming a video right now (updates wait until it's done)."
    [ -f /opt/gino/data/thinking ] && echo "   💭 Thinking right now (updates wait until he's finished)."
    if [ -s /var/lib/gino-deploy/bad-commit ]; then
      echo "   ⚠️  Skipped version $(head -c 7 /var/lib/gino-deploy/bad-commit) because it wouldn't start."
    fi
    ;;
  logs)    journalctl -u gino -u gino-update -n "${2:-80}" --no-pager ;;
  follow)  journalctl -u gino -f ;;
  restart) need_root; systemctl restart gino; echo "Gino restarted." ;;
  stop)    need_root; systemctl stop gino; echo "Gino is paused. Start him again with: gino start" ;;
  start)   need_root; systemctl start gino; echo "Gino is up." ;;
  update)  need_root; bash "$APP/deploy/update.sh" --verbose ;;
  backup)  need_root; bash "$APP/deploy/update.sh" --backup-only ;;
  password)
    need_root
    if [ -n "${2:-}" ]; then set_setting GINO_PASSWORD "$2"; systemctl restart gino; echo "Password changed."
    else echo "Gino's password: $(setting GINO_PASSWORD)"; fi
    ;;
  set-key)
    need_root
    read -r -p "Paste your Claude API key: " key
    [ -n "$key" ] || { echo "Nothing pasted, nothing changed."; exit 1; }
    set_setting ANTHROPIC_API_KEY "$key"; systemctl restart gino
    echo "Gino has his real brain now. 🧠"
    ;;
  telegram)
    need_root
    case "${2:-}" in
      off)
        unset_setting TELEGRAM_BOT_TOKEN; unset_setting TELEGRAM_CHAT_ID; systemctl restart gino
        echo "Gino's phone line is off. Connect again any time with: gino telegram" ;;
      test)
        [ -n "$(setting TELEGRAM_CHAT_ID)" ] || { echo "Not connected yet. Run: gino telegram"; exit 1; }
        TELEGRAM_BOT_TOKEN="$(setting TELEGRAM_BOT_TOKEN)" CHAT="$(setting TELEGRAM_CHAT_ID)" python3 -I -c '
import json, os, urllib.request
t, c = os.environ["TELEGRAM_BOT_TOKEN"], os.environ["CHAT"]
r = urllib.request.Request(f"https://api.telegram.org/bot{t}/sendMessage", headers={"Content-Type": "application/json"},
    data=json.dumps({"chat_id": c, "text": "🔔 Test from the server: the phone line works!"}).encode())
urllib.request.urlopen(r, timeout=15)' && echo "Sent a test message. Check your phone. 📱" \
          || echo "That didn't work. Try connecting again with: gino telegram" ;;
      *)
        echo "Let's connect Gino to your phone. 📱"
        echo "(If you haven't made a bot yet: in Telegram, message @BotFather, send /newbot, and follow along.)"
        read -r -p "Paste the token BotFather gave you: " token
        token="$(printf '%s' "$token" | tr -d '[:space:]')"
        [ -n "$token" ] || { echo "Nothing pasted, nothing changed."; exit 1; }
        systemctl stop gino  # so only this setup is listening to the bot for a moment
        if chat="$(TELEGRAM_BOT_TOKEN="$token" python3 -I "$APP/deploy/telegram_pair.py")" && [ -n "$chat" ]; then
          set_setting TELEGRAM_BOT_TOKEN "$token"; set_setting TELEGRAM_CHAT_ID "$chat"
          systemctl start gino
          echo; echo "🎉 Done! Gino can text you now, and you can text him back. Nobody else can talk to him there."
        else
          systemctl start gino
          echo "Nothing changed. Gino is back to normal."; exit 1
        fi ;;
    esac
    ;;
  whatsapp)
    need_root
    wa_env() { WHATSAPP_TOKEN="$(setting WHATSAPP_TOKEN)" WHATSAPP_PHONE_ID="$(setting WHATSAPP_PHONE_ID)" \
      WHATSAPP_TO="$(setting WHATSAPP_TO)" WHATSAPP_TEMPLATE="$(setting WHATSAPP_TEMPLATE)" \
      WHATSAPP_TEMPLATE_LANG="$(setting WHATSAPP_TEMPLATE_LANG)" "$@"; }
    case "${2:-}" in
      off)
        for k in WHATSAPP_TOKEN WHATSAPP_PHONE_ID WHATSAPP_TO WHATSAPP_APP_SECRET WHATSAPP_VERIFY_TOKEN \
                 WHATSAPP_TEMPLATE WHATSAPP_TEMPLATE_LANG; do unset_setting "$k"; done
        systemctl restart gino
        echo "Gino's WhatsApp line is off. Connect again any time with: gino whatsapp" ;;
      test)
        [ -n "$(setting WHATSAPP_TOKEN)" ] || { echo "Not connected yet. Run: gino whatsapp"; exit 1; }
        wa_env python3 -I "$APP/deploy/whatsapp_setup.py" test ;;
      webhook)
        [ -n "$(setting WHATSAPP_VERIFY_TOKEN)" ] || { echo "Not connected yet. Run: gino whatsapp"; exit 1; }
        echo "   Callback URL:  https://$(cat /var/lib/gino-deploy/domain 2>/dev/null)/whatsapp/webhook"
        echo "   Verify token:  $(setting WHATSAPP_VERIFY_TOKEN)" ;;
      template)
        [ -n "${3:-}" ] || { echo "Usage: gino whatsapp template NAME [LANGUAGE]   e.g. gino whatsapp template gino_nudge en_GB"; exit 1; }
        set_setting WHATSAPP_TEMPLATE "$3"; set_setting WHATSAPP_TEMPLATE_LANG "${4:-en_GB}"; systemctl restart gino
        echo "Gino's nudge is now the \"$3\" template (${4:-en_GB}). Try it with: gino whatsapp test" ;;
      *)
        echo "Let's connect Gino to your WhatsApp. 📱  (Do steps 1-4 of the WhatsApp guide first; it tells you"
        echo "where each of these is: https://github.com/rauulglez16-max/Gino-the-Capybara/blob/main/deploy/README.md )"
        echo
        read -r -p "1/4  Phone number ID: " phone_id
        read -r -p "2/4  Permanent access token: " token
        read -r -p "3/4  App secret: " secret
        read -r -p "4/4  Your own WhatsApp number, with country code (like 447700900123): " to
        phone_id="$(printf '%s' "$phone_id" | tr -dc '0-9')"; token="$(printf '%s' "$token" | tr -d '[:space:]')"
        secret="$(printf '%s' "$secret" | tr -d '[:space:]')"; to="$(printf '%s' "$to" | tr -dc '0-9')"
        to="${to#00}"
        { [ -n "$phone_id" ] && [ -n "$token" ] && [ -n "$secret" ] && [ -n "$to" ]; } \
          || { echo "Something was left empty, nothing changed."; exit 1; }
        WHATSAPP_TOKEN="$token" WHATSAPP_PHONE_ID="$phone_id" WHATSAPP_TO="$to" \
          python3 -I "$APP/deploy/whatsapp_setup.py" check || { echo "Nothing changed."; exit 1; }
        verify="$(setting WHATSAPP_VERIFY_TOKEN)"
        [ -n "$verify" ] || verify="$(tr -dc 'a-z0-9' </dev/urandom | head -c 24 || true)"
        set_setting WHATSAPP_PHONE_ID "$phone_id"; set_setting WHATSAPP_TOKEN "$token"
        set_setting WHATSAPP_APP_SECRET "$secret"; set_setting WHATSAPP_TO "$to"
        set_setting WHATSAPP_VERIFY_TOKEN "$verify"
        [ -n "$(setting WHATSAPP_TEMPLATE)" ] || { set_setting WHATSAPP_TEMPLATE hello_world; set_setting WHATSAPP_TEMPLATE_LANG en_US; }
        systemctl restart gino
        echo
        echo "Saved. 🎉 Last step: back in Meta, go to WhatsApp > Configuration > Webhook > Edit, and paste:"
        echo
        echo "   Callback URL:  https://$(cat /var/lib/gino-deploy/domain 2>/dev/null)/whatsapp/webhook"
        echo "   Verify token:  $verify"
        echo
        echo "Click \"Verify and save\", then next to \"messages\" click Subscribe."
        echo "Then send \"hi\" to Gino's number on WhatsApp. He'll answer! (See these again with: gino whatsapp webhook)" ;;
    esac
    ;;
  social)
    need_root
    case "${2:-status}" in
      setup)
        echo "Connect Gino to his Bluesky account. Use an APP PASSWORD (Bluesky: Settings > Privacy and security >"
        echo "App passwords), never your real Bluesky password."
        read -r -p "Gino's Bluesky handle (e.g. gino-capybara.bsky.social): " handle
        handle="${handle#@}"
        read -r -s -p "App password (nothing shows while you paste): " apppw; echo
        [ -n "$handle" ] && [ -n "$apppw" ] || { echo "Nothing entered, nothing changed."; exit 1; }
        set_setting GINO_BLUESKY_HANDLE "$handle"
        set_setting GINO_BLUESKY_APP_PASSWORD "$apppw"
        domain="$(cat /var/lib/gino-deploy/domain 2>/dev/null || true)"
        [ -n "$domain" ] && set_setting GINO_PUBLIC_URL "https://$domain"
        echo "Checking the login (nothing gets posted)..."
        if (cd "$APP" && export GINO_BLUESKY_HANDLE="$handle" GINO_BLUESKY_APP_PASSWORD="$apppw" \
              GINO_DATA_DIR=/opt/gino/data && as_gino /opt/gino/venv/bin/python -m gino.social test); then
          echo "Saved. Posting is still OFF. Turn it on with: gino social on"
        else
          echo "Saved, but the login didn't work. Check the handle and app password and run: gino social setup"
        fi
        ;;
      on)
        [ -n "$(setting GINO_BLUESKY_APP_PASSWORD)" ] || { echo "Run gino social setup first."; exit 1; }
        set_setting GINO_SOCIAL 1; systemctl restart gino
        echo "🦋 Gino can post on Bluesky now (at most 3 posts a day, 2 hours apart). Stop him any time with: gino social off"
        ;;
      off)
        set_setting GINO_SOCIAL 0; systemctl restart gino
        echo "Bluesky posting is OFF. His account and old posts stay as they are."
        ;;
      status)
        if [ "$(setting GINO_SOCIAL)" = "1" ]; then echo "🦋 Bluesky posting is ON as @$(setting GINO_BLUESKY_HANDLE)"
        else echo "Bluesky posting is OFF$( [ -n "$(setting GINO_BLUESKY_HANDLE)" ] && echo " (account: @$(setting GINO_BLUESKY_HANDLE))")"; fi
        ;;
      *) echo "usage: gino social [status|setup|on|off]"; exit 1 ;;
    esac
    ;;
  photos)
    need_root
    case "${2:-status}" in
      on)
        echo "Installing Gino's camera (a headless browser, about 300 MB). This takes a few minutes..."
        # Playwright's own helper needs libatomic, which minimal Ubuntu servers don't have
        apt-get install -y -qq libatomic1 >/dev/null
        /opt/gino/venv/bin/pip install -q playwright
        mkdir -p /opt/gino/browsers
        PLAYWRIGHT_BROWSERS_PATH=/opt/gino/browsers /opt/gino/venv/bin/python -m playwright install --with-deps --only-shell chromium
        chmod -R a+rX /opt/gino/browsers
        set_setting PLAYWRIGHT_BROWSERS_PATH /opt/gino/browsers
        set_setting GINO_PHOTOS 1
        systemctl restart gino
        echo "📸 Camera installed. Test it with: gino photos test"
        ;;
      test)
        sleep 3
        out=/opt/gino/data/photo-test.jpg
        # run it exactly like Gino runs: same user, same settings
        if systemd-run --quiet --wait --pipe --uid=gino --gid=gino -p EnvironmentFile="$ENV_FILE" \
             -p WorkingDirectory="$APP" -E HOME=/tmp /opt/gino/venv/bin/python -m gino.photo test "$out" "${3:-selfie}"; then
          echo "Copy it to your computer to look at it:  scp root@$(curl -s -4 ifconfig.me 2>/dev/null || echo YOUR.IP):$out ."
        fi
        ;;
      off)
        set_setting GINO_PHOTOS 0; systemctl restart gino
        echo "Photos are OFF. Gino still posts, just without pictures."
        ;;
      status)
        [ "$(setting GINO_PHOTOS)" = "1" ] && echo "📸 Photos are ON" || echo "Photos are OFF (turn on with: gino photos on)"
        ;;
      *) echo "usage: gino photos [status|on|test|off]"; exit 1 ;;
    esac
    ;;
  clips)
    need_root
    case "${2:-status}" in
      on)
        echo "Installing Gino's video camera (a headless browser and a video maker, about 400 MB). This takes a few minutes..."
        apt-get install -y -qq libatomic1 ffmpeg >/dev/null
        if ! /opt/gino/venv/bin/python -c "import playwright" 2>/dev/null || [ ! -d /opt/gino/browsers ]; then
          /opt/gino/venv/bin/pip install -q playwright
          mkdir -p /opt/gino/browsers
          PLAYWRIGHT_BROWSERS_PATH=/opt/gino/browsers /opt/gino/venv/bin/python -m playwright install --with-deps --only-shell chromium
          chmod -R a+rX /opt/gino/browsers
        fi
        set_setting PLAYWRIGHT_BROWSERS_PATH /opt/gino/browsers
        domain="$(cat /var/lib/gino-deploy/domain 2>/dev/null || true)"
        [ -n "$domain" ] && [ -z "$(setting GINO_PUBLIC_URL)" ] && set_setting GINO_PUBLIC_URL "https://$domain"
        set_setting GINO_CLIPS 1
        systemctl restart gino
        echo "🎬 Video camera installed! Gino films one video every evening, and you can make more any time:"
        echo "   open your private page, then the Videos tab. (Make a test one here with: gino clips test)"
        ;;
      test)
        sleep 3
        out=/opt/gino/data/clip-test.mp4
        echo "Filming a test video. This takes a few minutes on the server..."
        if systemd-run --quiet --wait --pipe --uid=gino --gid=gino -p EnvironmentFile="$ENV_FILE" \
             -p WorkingDirectory="$APP" -E HOME=/tmp /opt/gino/venv/bin/python -m gino.clips test "${3:-}" "$out"; then
          echo "It's also on your private page, in the Videos tab, the next time Gino films one."
        fi
        ;;
      off)
        set_setting GINO_CLIPS 0; systemctl restart gino
        echo "The video camera is OFF. The videos he already made stay on your private page."
        ;;
      daily)
        n="${3:-}"; case "$n" in 0|1|2|3) ;; *) echo "usage: gino clips daily 0|1|2|3   (videos he films by himself each evening)"; exit 1 ;; esac
        set_setting GINO_CLIPS_PER_DAY "$n"; systemctl restart gino
        echo "Gino will film $n video(s) by himself each evening."
        ;;
      quality)
        case "${3:-}" in
          hd) set_setting GINO_CLIP_LOOK hd; systemctl restart gino
              echo "🎬 New videos will be in full HD with all the detail. Each one takes the server a lot longer to film (and needs about 1 GB of memory)." ;;
          basic) set_setting GINO_CLIP_LOOK basic; systemctl restart gino
              echo "🎬 New videos will use the simpler, quicker look (smaller and less detailed)." ;;
          auto) unset_setting GINO_CLIP_LOOK; systemctl restart gino
              echo "🎬 Gino picks: full HD on a server with 2 GB of memory and 2 processors or more, the lighter look on a smaller one." ;;
          *) echo "usage: gino clips quality hd|basic|auto"; exit 1 ;;
        esac
        ;;
      status)
        [ "$(setting GINO_CLIPS)" = "1" ] && echo "🎬 The video camera is ON ($(setting GINO_CLIPS_PER_DAY | sed 's/^$/1/') a day by himself, $(setting GINO_CLIP_LOOK | sed 's/^$/auto/') quality)" \
          || echo "The video camera is OFF (turn on with: gino clips on)"
        ;;
      *) echo "usage: gino clips [status|on|test|daily N|quality hd|basic|off]"; exit 1 ;;
    esac
    ;;
  polish)
    need_root
    case "${2:-status}" in
      server|pc)
        [ "$(setting GINO_CLIPS)" = "1" ] || echo "(Note: the video camera is off. Turn it on with: gino clips on)"
        install_narrator || echo "⚠️  Couldn't install the narrator's voice this time. Videos still get polished, just without a narrator. Try again later with: gino polish $2"
        set_setting GINO_POLISHER "$2"; systemctl restart gino
        if [ "$2" = server ]; then
          echo "✨ The SERVER now polishes every new video, day and night (it takes the server a few minutes)."
          echo "   Your PC's FilmCraft script will find nothing to do, so it doesn't matter if your PC is on or off."
        else
          echo "✨ Your PC (FilmCraft) polishes new videos. When your PC is off, or hasn't finished a video"
          echo "   within about 40 minutes, the server polishes it instead so nothing waits forever."
        fi
        ;;
      off)
        set_setting GINO_POLISHER off; systemctl restart gino
        echo "Polishing is OFF. New videos stay exactly as Gino films them. (Turn it back on with: gino polish server  or  gino polish pc)"
        ;;
      voice)
        case "${3:-}" in
          on)  unset_setting GINO_POLISH_NARRATOR; install_narrator || echo "⚠️  Couldn't install the voice this time."; systemctl restart gino
               echo "🗣️  The narrator reads the captions in videos the server polishes." ;;
          off) set_setting GINO_POLISH_NARRATOR 0; systemctl restart gino
               echo "The narrator is OFF: the server polishes videos without reading the captions aloud." ;;
          *)   echo "usage: gino polish voice on|off"; exit 1 ;;
        esac
        ;;
      status)
        case "$(setting GINO_POLISHER)" in
          server) echo "✨ Videos are polished on the SERVER (change with: gino polish pc  or  gino polish off)" ;;
          off)    echo "Polishing is OFF (turn on with: gino polish server  or  gino polish pc)" ;;
          *)      echo "✨ Videos are polished by FilmCraft on your PC, with the server as backup when your PC is off"
                  echo "   (change with: gino polish server  or  gino polish off)" ;;
        esac
        if [ "$(setting GINO_POLISH_NARRATOR)" = "0" ]; then echo "   Narrator on the server: off (gino polish voice on)"
        elif [ -s "$(setting GINO_POLISH_VOICE)" ]; then echo "   Narrator on the server: on 🗣️"
        else echo "   Narrator on the server: not installed yet (it installs with: gino polish server  or  gino polish pc)"; fi
        ;;
      *) echo "usage: gino polish [status|server|pc|off|voice on|voice off]"; exit 1 ;;
    esac
    ;;
  tiktok)
    need_root
    case "${2:-status}" in
      setup)
        domain="$(cat /var/lib/gino-deploy/domain 2>/dev/null || true)"
        echo "Connect Gino's videos to TikTok. You need your own TikTok developer app first (see the guide:"
        echo "https://github.com/rauulglez16-max/Gino-the-Capybara/blob/main/deploy/README.md#gino-on-tiktok-)."
        echo "In the app's Login Kit settings, the Redirect URI must be exactly:  https://$domain/tiktok/callback"
        echo
        read -r -p "1/2  Client key: " ck
        read -r -s -p "2/2  Client secret (nothing shows while you paste): " cs; echo
        ck="$(printf '%s' "$ck" | tr -d '[:space:]')"; cs="$(printf '%s' "$cs" | tr -d '[:space:]')"
        [ -n "$ck" ] && [ -n "$cs" ] || { echo "Something was left empty, nothing changed."; exit 1; }
        set_setting GINO_TIKTOK_CLIENT_KEY "$ck"; set_setting GINO_TIKTOK_CLIENT_SECRET "$cs"
        [ -n "$domain" ] && set_setting GINO_PUBLIC_URL "https://$domain"
        [ -n "$(setting GINO_TIKTOK_MODE)" ] || set_setting GINO_TIKTOK_MODE drafts
        systemctl restart gino
        echo "Saved. 🎉 Last step: open your private page, go to the Videos tab and press \"Connect TikTok\"."
        ;;
      mode)
        case "${3:-}" in
          drafts|direct) set_setting GINO_TIKTOK_MODE "$3"; systemctl restart gino
            echo "TikTok mode is now: $3. Press \"Connect TikTok\" on your private page again so TikTok asks for the right permission." ;;
          *) echo "usage: gino tiktok mode drafts|direct"; echo "  drafts: videos land in your TikTok inbox and you post them from the app (easiest)"
             echo "  direct: videos post straight to the account (needs TikTok's video.publish permission)"; exit 1 ;;
        esac
        ;;
      auto)
        case "${3:-}" in
          on) set_setting GINO_TIKTOK_AUTO 1; systemctl restart gino; echo "📱 Gino's daily video goes to TikTok by itself now." ;;
          off) set_setting GINO_TIKTOK_AUTO 0; systemctl restart gino; echo "Videos only go to TikTok when you press the button." ;;
          *) echo "usage: gino tiktok auto on|off"; exit 1 ;;
        esac
        ;;
      privacy)
        case "${3:-}" in
          everyone) v=PUBLIC_TO_EVERYONE ;; followers) v=FOLLOWER_OF_CREATOR ;; friends) v=MUTUAL_FOLLOW_FRIENDS ;; onlyme|only-me) v=SELF_ONLY ;;
          *) echo "usage: gino tiktok privacy everyone|followers|friends|onlyme"
             echo "  Who can see the videos Gino posts by himself in direct mode (now: $(setting GINO_TIKTOK_PRIVACY | sed 's/^$/SELF_ONLY/'))."
             echo "  TikTok only allows 'everyone' after it has reviewed your developer app; until then his posts stay 'only me'."; exit 1 ;;
        esac
        set_setting GINO_TIKTOK_PRIVACY "$v"; systemctl restart gino
        echo "Videos Gino posts by himself will be visible to: $3."
        [ "$(setting GINO_TIKTOK_MODE)" = "direct" ] || echo "(This only matters in direct mode: gino tiktok mode direct)"
        ;;
      off)
        unset_setting GINO_TIKTOK_CLIENT_KEY; unset_setting GINO_TIKTOK_CLIENT_SECRET; set_setting GINO_TIKTOK_AUTO 0
        systemctl restart gino
        echo "TikTok is disconnected. Videos stay on your private page to download."
        ;;
      status)
        if [ -n "$(setting GINO_TIKTOK_CLIENT_KEY)" ]; then
          echo "📱 TikTok is set up (mode: $(setting GINO_TIKTOK_MODE | sed 's/^$/drafts/'), automatic: $( [ "$(setting GINO_TIKTOK_AUTO)" = "1" ] && echo on || echo off ), who sees his own posts: $(setting GINO_TIKTOK_PRIVACY | sed 's/^$/SELF_ONLY/'))."
          echo "   Connect or check the account on your private page, in the Videos tab."
        else echo "TikTok isn't set up (gino tiktok setup). You can still download videos from your private page."; fi
        ;;
      *) echo "usage: gino tiktok [status|setup|mode drafts|direct|auto on|off|privacy everyone|followers|friends|onlyme|off]"; exit 1 ;;
    esac
    ;;
  shop)
    need_root
    shop_py() { systemd-run --quiet --wait --pipe --uid=gino --gid=gino -p EnvironmentFile="$ENV_FILE" \
      -p WorkingDirectory="$APP" -E HOME=/tmp /opt/gino/venv/bin/python -m gino.shop "$@"; }
    case "${2:-status}" in
      setup)
        echo "Connect Gino's shop to YOUR Stripe account. 🛒"
        echo "Paste a RESTRICTED key (it starts with rk_live_). Never paste your secret key (sk_live_...)."
        echo "The guide shows how to make one: https://github.com/rauulglez16-max/Gino-the-Capybara/blob/main/deploy/README.md"
        read -r -s -p "Restricted key (nothing shows while you paste): " key; echo
        key="$(printf '%s' "$key" | tr -d '[:space:]')"
        case "$key" in
          rk_live_*|rk_test_*) ;;
          sk_*) echo "❌ That's a SECRET key, which can do anything with your money. Make a restricted key instead. Nothing changed."; exit 1 ;;
          *) echo "❌ That doesn't look like a restricted key (rk_live_...). Nothing changed."; exit 1 ;;
        esac
        set_setting GINO_STRIPE_KEY "$key"
        domain="$(cat /var/lib/gino-deploy/domain 2>/dev/null || true)"
        [ -n "$domain" ] && set_setting GINO_PUBLIC_URL "https://$domain"
        echo "Checking the key (nothing is sold or charged)..."
        if shop_py test; then echo "Saved. The shop is still CLOSED. Open it with: gino shop on"
        else echo "Saved, but the check failed. Look at the message above, fix the key in Stripe, and run: gino shop setup"; fi
        ;;
      on)
        [ -n "$(setting GINO_STRIPE_KEY)" ] || { echo "Run gino shop setup first."; exit 1; }
        set_setting GINO_SHOP 1; systemctl restart gino
        shop_py reopen >/dev/null 2>&1 || true
        echo "🛒 Gino's shop is OPEN at https://$(cat /var/lib/gino-deploy/domain 2>/dev/null)/blog/shop"
        echo "   He decides what to sell. Close it any time with: gino shop off"
        ;;
      off)
        set_setting GINO_SHOP 0; systemctl restart gino
        echo "🔒 The shop is CLOSED. Nobody can buy anything now."
        [ -n "$(setting GINO_STRIPE_KEY)" ] && { shop_py close || true; }
        echo "   People who already bought can still download what they paid for."
        ;;
      sales)
        [ -n "$(setting GINO_STRIPE_KEY)" ] || { echo "The shop isn't set up yet (gino shop setup)."; exit 1; }
        shop_py sales
        echo "   Your money, fees and payouts: https://dashboard.stripe.com/payments"
        ;;
      test) shop_py test ;;
      status)
        if [ "$(setting GINO_SHOP)" = "1" ]; then echo "🛒 The shop is OPEN: https://$(cat /var/lib/gino-deploy/domain 2>/dev/null)/blog/shop"
        else echo "The shop is CLOSED$( [ -n "$(setting GINO_STRIPE_KEY)" ] && echo ' (set up, open it with: gino shop on)' || echo ' (not set up yet: gino shop setup)')"; fi
        ;;
      *) echo "usage: gino shop [status|setup|on|off|sales|test]"; exit 1 ;;
    esac
    ;;
  dreams)
    case "${2:-status}" in
      on)  need_root; unset_setting GINO_DREAMS; systemctl restart gino; echo "🌙 Gino will dream when he sleeps." ;;
      off) need_root; set_setting GINO_DREAMS 0; systemctl restart gino; echo "Dreams are off. Gino sleeps soundly." ;;
      status) [ "$(setting GINO_DREAMS)" = "0" ] && echo "Dreams are OFF (turn on with: gino dreams on)" || echo "🌙 Dreams are ON" ;;
      *) echo "usage: gino dreams [status|on|off]"; exit 1 ;;
    esac
    ;;
  stream)
    need_root
    run_as_gino() { systemd-run --quiet --wait --pipe --uid=gino --gid=gino -p EnvironmentFile="$ENV_FILE" \
                      -p WorkingDirectory="$APP" -p Nice=10 -E HOME=/tmp /opt/gino/venv/bin/python -m gino.stream "$@"; }
    case "${2:-status}" in
      youtube)
        echo "Paste Gino's YouTube stream key (YouTube Studio > Create > Go live > Stream > Stream key),"
        echo "then press Enter. It stays on this server only."
        read -r -s -p "Stream key: " key; echo
        key="$(printf '%s' "$key" | tr -d '[:space:]')"
        [ -n "$key" ] || { echo "Nothing pasted, nothing changed."; exit 1; }
        set_setting GINO_STREAM_YOUTUBE_KEY "$key"
        systemctl try-restart gino-stream || true
        echo "✅ Saved. Test it with: gino stream test   Go live with: gino stream on"
        ;;
      tiktok)
        echo "Paste the two things TikTok shows you for streaming with other software: the Server URL and the Stream key."
        read -r -p "Server URL (starts with rtmp): " url
        read -r -s -p "Stream key: " key; echo
        url="$(printf '%s' "$url" | tr -d '[:space:]')"; key="$(printf '%s' "$key" | tr -d '[:space:]')"
        case "$url" in rtmp://*|rtmps://*) ;; *) echo "That Server URL doesn't look right (it starts with rtmp://). Nothing changed."; exit 1 ;; esac
        [ -n "$key" ] || { echo "No stream key pasted, nothing changed."; exit 1; }
        set_setting GINO_STREAM_TIKTOK_URL "$url"; set_setting GINO_STREAM_TIKTOK_KEY "$key"
        echo "✅ Saved. TikTok often gives a new key for each live: paste it again before each one."
        echo "   Go live for 90 minutes with: gino stream tiktok-live 90"
        ;;
      install)
        echo "Installing the TV studio (a headless browser and a video maker, about 400 MB). This takes a few minutes..."
        apt-get install -y -qq libatomic1 ffmpeg >/dev/null
        if ! /opt/gino/venv/bin/python -c "import playwright" 2>/dev/null || [ ! -d /opt/gino/browsers ]; then
          /opt/gino/venv/bin/pip install -q playwright
          mkdir -p /opt/gino/browsers
          PLAYWRIGHT_BROWSERS_PATH=/opt/gino/browsers /opt/gino/venv/bin/python -m playwright install --with-deps --only-shell chromium
          chmod -R a+rX /opt/gino/browsers
        fi
        set_setting PLAYWRIGHT_BROWSERS_PATH /opt/gino/browsers
        install -m 644 "$APP/deploy/systemd/gino-stream.service" /etc/systemd/system/; systemctl daemon-reload
        echo "📺 Studio installed."
        ;;
      test)
        "$0" stream install
        out=/opt/gino/data/stream-test.mp4
        if run_as_gino test "$out" 30 ${3:+--tall}; then
          echo "Copy it to your computer to watch it (in PowerShell):  scp root@$(server_ip):$out ."
        fi
        ;;
      on)
        [ -n "$(setting GINO_STREAM_YOUTUBE_KEY)" ] || { echo "First paste YouTube's stream key: gino stream youtube"; exit 1; }
        cpus="$(nproc)"
        if [ "$cpus" -lt 4 ]; then
          echo "⚠️  This server has $cpus processors. The stream works best with 4 or more (see the guide: \"A bigger server\")."
          read -r -p "Go live anyway? (y/n) " yn; [ "$yn" = "y" ] || exit 1
        fi
        "$0" stream install
        systemctl enable --now gino-stream >/dev/null
        echo "📺 Gino is going live on YouTube, day and night. The first scene takes a few minutes to film,"
        echo "   then it appears in YouTube Studio. Stop any time with: gino stream off"
        ;;
      off)
        systemctl disable --now gino-stream >/dev/null 2>&1 || true
        systemctl stop gino-stream-tiktok >/dev/null 2>&1 || true
        echo "The live stream is OFF."
        ;;
      tiktok-live)
        mins="${3:-90}"; case "$mins" in ''|*[!0-9]*) echo "usage: gino stream tiktok-live MINUTES"; exit 1 ;; esac
        [ -n "$(setting GINO_STREAM_TIKTOK_KEY)" ] || { echo "First paste TikTok's server URL and key: gino stream tiktok"; exit 1; }
        "$0" stream install
        systemctl stop gino-stream-tiktok >/dev/null 2>&1 || true
        systemd-run --quiet --unit=gino-stream-tiktok --uid=gino --gid=gino -p EnvironmentFile="$ENV_FILE" \
          -p WorkingDirectory="$APP" -p Nice=10 -E HOME=/tmp /opt/gino/venv/bin/python -m gino.stream run tiktok --minutes "$mins"
        echo "📱 Gino goes live on TikTok for $mins minutes (the first scene takes a few minutes to film). Stop early with: gino stream off"
        ;;
      logs) journalctl -u gino-stream -u gino-stream-tiktok -n "${3:-60}" --no-pager ;;
      status)
        systemctl is-active --quiet gino-stream && echo "📺 LIVE on YouTube, day and night (stop with: gino stream off)" \
          || echo "The YouTube stream is OFF$( [ -n "$(setting GINO_STREAM_YOUTUBE_KEY)" ] && echo ' (key saved: gino stream on)' || echo ' (set up with: gino stream youtube)')"
        systemctl is-active --quiet gino-stream-tiktok && echo "📱 LIVE on TikTok right now"
        echo "   Server processors: $(nproc) (4 or more recommended)"
        ;;
      *) echo "usage: gino stream [status|youtube|tiktok|test|on|off|tiktok-live MINUTES|logs]"; exit 1 ;;
    esac
    ;;
  news)
    case "${2:-status}" in
      on)  need_root; unset_setting GINO_NEWS; systemctl restart gino; echo "📰 Gino will hear one gentle headline each morning." ;;
      off) need_root; set_setting GINO_NEWS 0; systemctl restart gino; echo "The news is off. Gino's meadow is quiet." ;;
      status) [ "$(setting GINO_NEWS)" = "0" ] && echo "The news is OFF (turn on with: gino news on)" || echo "📰 The morning news is ON" ;;
      *) echo "usage: gino news [status|on|off]"; exit 1 ;;
    esac
    ;;
  domain)
    need_root
    ip="$(server_ip)"; [ -n "$ip" ] || { echo "Couldn't work out this server's IP address. Nothing changed."; exit 1; }
    free="${ip//./-}.sslip.io"
    current="$(cat /var/lib/gino-deploy/domain 2>/dev/null || echo "$free")"
    case "${2:-}" in
      "")
        echo "Gino's address: https://$current"
        [ "$current" = "$free" ] && echo "To use your own name (like ginothecapybara.com), point it at $ip and run: gino domain yourname.com"
        ;;
      off)
        write_caddyfile "$free"
        use_address "$free"
        echo "Back to the free address: https://$free" ;;
      *)
        name="$(printf '%s' "$2" | tr 'A-Z' 'a-z' | sed -E 's#^https?://##; s#/.*$##; s#^www\.##')"
        if ! printf '%s' "$name" | grep -Eq '^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,24}$'; then
          echo "❌ \"$2\" doesn't look like a web address. Type it like this: gino domain ginothecapybara.com"; exit 1
        fi
        echo "Checking that $name points at this server ($ip)..."
        if ! points_here "$name" "$ip"; then
          found="$(getent ahostsv4 "$name" 2>/dev/null | awk '{print $1}' | sort -u | tr '\n' ' ')"
          echo "❌ Not yet: $name points at ${found:-nothing yet}, not $ip."
          echo "   In your domain shop's DNS settings, add an A record: host @ (blank), answer $ip."
          echo "   New records usually work within 10 to 30 minutes (sometimes a few hours). Then run this again."
          echo "   Nothing changed. Gino is still at https://$current"
          exit 1
        fi
        others=("$free")
        if points_here "www.$name" "$ip"; then others=("www.$name" "${others[@]}"); www=1; else www=""; fi
        [ "$current" != "$free" ] && [ "$current" != "$name" ] && others+=("$current")
        write_caddyfile "$name" "${others[@]}"
        use_address "$name"
        echo "Getting the padlock (https certificate) for $name. This takes up to a minute..."
        ok=""
        for _ in $(seq 1 30); do
          if curl -fsS -o /dev/null --max-time 5 "https://$name/"; then ok=1; break; fi
          sleep 3
        done
        if [ -n "$ok" ]; then
          echo; echo "🎉 Done! Gino lives at https://$name"
          echo "   Your private page: https://$name/private"
          echo "   The old address (https://$free) now sends visitors to the new one."
        else
          echo; echo "⏳ Almost: the settings are saved, but the padlock isn't ready yet. Try https://$name in a few minutes."
          echo "   If it still doesn't work in an hour, run: gino logs   (or go back with: gino domain off)"
        fi
        [ -z "$www" ] && echo "   Tip: to make www.$name work too, add a CNAME record: host www, answer $name. Then run this again."
        ;;
    esac
    ;;
  settings) need_root; "${EDITOR:-nano}" "$ENV_FILE" && systemctl restart gino && echo "Saved and restarted." ;;
  *)
    cat <<'EOF'
gino status      is he running, which version, which brain
gino logs        what happened recently
gino follow      watch what he's doing live (Ctrl+C to stop watching)
gino restart     restart him
gino stop/start  pause him / wake him up again
gino update      check GitHub for new code right now
gino backup      save a copy of his memories now
gino password    show (or: gino password NEW to change) the private page's password
gino domain      use your own web address: gino domain ginothecapybara.com (or: gino domain off)
gino set-key     give him his Claude API key
gino telegram    connect him to your phone (gino telegram test / gino telegram off)
gino whatsapp    connect him to your WhatsApp (gino whatsapp test / webhook / template / off)
gino social      Bluesky posting: gino social setup | on | off | status
gino photos      photos in his posts: gino photos on | test | off
gino clips       his videos: gino clips on | test | daily N | quality hd|basic | off
gino polish      who polishes his videos: gino polish server | pc | off (and: gino polish voice on/off)
gino tiktok      send videos to TikTok: gino tiktok setup | mode | auto on/off | privacy | off
gino shop        his shop: gino shop setup | on | off | sales | status
gino dreams      his dreams at night: gino dreams on | off | status
gino stream      live TV: gino stream youtube | test | on | off | tiktok | tiktok-live 90 | status
gino news        his gentle morning headline: gino news on | off | status
gino settings    edit all his settings
EOF
    ;;
esac
